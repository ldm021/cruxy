# Copiá este archivo a `.env` y pegá los valores de tu proyecto Firebase.
#
#   Firebase Console > ⚙ Configuración del proyecto > Tus apps > App web
#
# Ojo: estas claves NO son secretas (viajan al navegador de todas formas).
# La seguridad real la dan firestore.rules y storage.rules.
# La API key de Anthropic NUNCA va acá — va en Cloud Functions (ver README).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console > ⚙ Configuración > Cloud Messaging > Certificados push web
# ("Web Push certificates" > Generar par de claves). Sin esto no hay push.
VITE_FIREBASE_VAPID_KEY=

# Región donde desplegás las Cloud Functions (debe coincidir con functions/index.js)
VITE_FUNCTIONS_REGION=us-central1

# Poné 1 para usar los emuladores locales (firebase emulators:start)
VITE_USE_EMULATORS=0
