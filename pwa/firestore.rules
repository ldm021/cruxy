rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Quién es "la familia"
    //
    // Por defecto alcanza con estar autenticado (Anonymous Auth). Eso es
    // razonable para un proyecto casero, pero cualquiera que consiga la URL
    // puede entrar.
    //
    // Para cerrarlo de verdad: entra a Firebase Console > Authentication >
    // Usuarios, copia los UID de tu familia y pégalos en la lista de abajo.
    // Con la lista no vacía, solo esos UID pueden leer y escribir.
    // -----------------------------------------------------------------------
    function allowlist() {
      return [];
      // Ejemplo:
      // return ['AbC123...', 'DeF456...', 'GhI789...'];
    }

    function isFamily() {
      return request.auth != null
        && (allowlist().size() == 0 || request.auth.uid in allowlist());
    }

    // -----------------------------------------------------------------------
    // Perfiles: cada quien administra el suyo y solo el suyo.
    // Las Cloud Functions usan el SDK admin, que no pasa por estas reglas, así
    // que igual pueden leer todos los tokens para mandar los push.
    // -----------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isFamily() && request.auth.uid == uid;
      // El nombre puede no estar todavía (el token de push se guarda por su
      // cuenta), así que solo lo validamos cuando viene.
      allow write: if isFamily()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'fcmToken', 'updatedAt'])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 40));
    }

    // -----------------------------------------------------------------------
    // Crucigramas: los crea la Cloud Function `extractCrossword` (SDK admin).
    // Desde la app solo se puede cambiar el estado activo/completado.
    // -----------------------------------------------------------------------
    match /crosswords/{crosswordId} {
      allow read: if isFamily();
      allow create, delete: if false;
      allow update: if isFamily()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['active', 'completed'];

      // ---------------------------------------------------------------------
      // Casillas: aquí es donde escribe todo el mundo, así que es la superficie
      // que más conviene acotar.
      // ---------------------------------------------------------------------
      match /cells/{cellId} {
        allow read: if isFamily();
        allow delete: if false;
        allow create, update: if isFamily()
          && request.resource.data.keys()
               .hasOnly(['value', 'filledBy', 'filledByUid', 'updatedAt'])
          && request.resource.data.value is string
          && request.resource.data.value.size() <= 1
          && request.resource.data.filledBy is string
          && request.resource.data.filledBy.size() <= 40
          // Nadie puede firmar una letra con el uid de otra persona: de eso
          // depende que el push no le llegue a quien la escribió.
          && request.resource.data.filledByUid ==
               (request.resource.data.value == '' ? '' : request.auth.uid);
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
