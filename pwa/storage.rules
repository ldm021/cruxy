rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de crucigramas. Cada persona sube dentro de su propia carpeta;
    // la Cloud Function las lee con el SDK admin (que no pasa por estas reglas).
    match /crossword-uploads/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // Leer la foto original sirve para revisar una extracción dudosa.
      allow read: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
